# Normalize text files to LF in the repository and working tree.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.sln text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.bmp binary
*.hdr binary
*.exr binary
*.ttf binary
*.otf binary
*.wav binary
*.mp3 binary
*.ogg binary
*.flac binary
*.glb binary
*.fbx binary
*.bin binary
*.spv binary
*.ico binary
*.icns binary
