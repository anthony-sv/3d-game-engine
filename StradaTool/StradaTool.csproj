<Project Sdk="Microsoft.NET.Sdk">
	<!-- strada, the command-line tool of the Strada editor: `strada mcp` serves the editor's automation commands to AI agents
	     over the Model Context Protocol (stdio), and call, commands, launch and instances use them from a shell
	     (Docs/Automation.md). CMake builds it next to StradaEditor. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>strada</AssemblyName>
		<RootNamespace>Strada.Tool</RootNamespace>
		<Version>0.1.0</Version>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Strada.Tool.Tests" />
	</ItemGroup>
</Project>
