<Project Sdk="Microsoft.NET.Sdk">
	<!-- A test fixture: the shape of the samples' script projects, with a block that only the repository uses. -->
	<Import Project="Strada.props" Condition="Exists('Strada.props')" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Game</RootNamespace>
	</PropertyGroup>

	<!-- strada:repository-only -->
	<!-- In the engine's repository, builds without Strada.props use the scripting API from source. -->
	<ItemGroup Condition="'$(StradaScriptCoreAssembly)' == ''">
		<ProjectReference Include="../../../Strada-ScriptCore/Strada.ScriptCore.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>
	<!-- /strada:repository-only -->
</Project>
