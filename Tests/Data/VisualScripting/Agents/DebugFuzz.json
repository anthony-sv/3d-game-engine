[
	{ "graph": "asset://Scripts/Ponger.sgraph", "description": "Count to three in a While on every Tick", "operations": [
		{"op": "AddVariable", "name": "Loops", "type": "int"},
		{"op": "AddVariable", "name": "Ticks", "type": "int", "public": true},
		{"op": "AddNode", "type": "Event.Custom", "settings": {"Name": "Tick"}, "as": "$tick"},
		{"op": "AddNode", "type": "Variable.Set", "settings": {"Variable": "Loops"}, "literals": {"Value": 0}, "as": "$reset"},
		{"op": "AddNode", "type": "Expression", "settings": {"Formula": "loops < 3"}, "as": "$more"},
		{"op": "AddNode", "type": "Variable.Get", "settings": {"Variable": "Loops"}, "as": "$loops"},
		{"op": "AddNode", "type": "Flow.While", "as": "$while"},
		{"op": "AddNode", "type": "Expression", "settings": {"Formula": "loops + 1"}, "as": "$next"},
		{"op": "AddNode", "type": "Variable.Set", "settings": {"Variable": "Loops"}, "as": "$count"},
		{"op": "AddNode", "type": "Expression", "settings": {"Formula": "ticks + 1"}, "as": "$tickNext"},
		{"op": "AddNode", "type": "Variable.Get", "settings": {"Variable": "Ticks"}, "as": "$ticks"},
		{"op": "AddNode", "type": "Variable.Set", "settings": {"Variable": "Ticks"}, "as": "$done"},
		{"op": "Connect", "from": ["$tick", "Then"], "to": ["$reset", "Execute"]},
		{"op": "Connect", "from": ["$reset", "Then"], "to": ["$while", "Execute"]},
		{"op": "Connect", "from": ["$loops", "Value"], "to": ["$more", "loops"]},
		{"op": "Connect", "from": ["$more", "Result"], "to": ["$while", "Condition"]},
		{"op": "Connect", "from": ["$while", "Body"], "to": ["$count", "Execute"]},
		{"op": "Connect", "from": ["$loops", "Value"], "to": ["$next", "loops"]},
		{"op": "Connect", "from": ["$next", "Result"], "to": ["$count", "Value"]},
		{"op": "Connect", "from": ["$while", "Completed"], "to": ["$done", "Execute"]},
		{"op": "Connect", "from": ["$ticks", "Value"], "to": ["$tickNext", "ticks"]},
		{"op": "Connect", "from": ["$tickNext", "Result"], "to": ["$done", "Value"]},
		{"op": "Arrange", "scope": "Graph"}
	] },
	{ "graph": "asset://Scripts/Waiter.sgraph", "description": "Wait in a latent function, one call at a time", "operations": [
		{"op": "AddVariable", "name": "Waiting", "type": "bool"},
		{"op": "AddVariable", "name": "Waits", "type": "int", "public": true},
		{"op": "AddFunction", "name": "Pause", "as": "$pause", "entryAs": "$entry", "returnAs": "$return"},
		{"op": "AddNode", "type": "Flow.Delay", "function": "Pause", "literals": {"Duration": 0.05}, "as": "$delay"},
		{"op": "Connect", "from": ["$entry", "Then"], "to": ["$delay", "Execute"]},
		{"op": "Connect", "from": ["$delay", "Completed"], "to": ["$return", "Execute"]},
		{"op": "AddNode", "type": "Variable.Get", "settings": {"Variable": "Waiting"}, "as": "$waiting"},
		{"op": "AddNode", "type": "Flow.Branch", "as": "$idle"},
		{"op": "AddNode", "type": "Variable.Set", "settings": {"Variable": "Waiting"}, "literals": {"Value": true}, "as": "$start"},
		{"op": "AddNode", "type": "Function.Call", "settings": {"Function": "Pause"}, "as": "$call"},
		{"op": "AddNode", "type": "Expression", "settings": {"Formula": "waits + 1"}, "as": "$waitsNext"},
		{"op": "AddNode", "type": "Variable.Get", "settings": {"Variable": "Waits"}, "as": "$waits"},
		{"op": "AddNode", "type": "Variable.Set", "settings": {"Variable": "Waits"}, "as": "$count"},
		{"op": "AddNode", "type": "Variable.Set", "settings": {"Variable": "Waiting"}, "literals": {"Value": false}, "as": "$end"},
		{"op": "Connect", "from": [2, "Then"], "to": ["$idle", "Execute"]},
		{"op": "Connect", "from": ["$waiting", "Value"], "to": ["$idle", "Condition"]},
		{"op": "Connect", "from": ["$idle", "False"], "to": ["$start", "Execute"]},
		{"op": "Connect", "from": ["$start", "Then"], "to": ["$call", "Execute"]},
		{"op": "Connect", "from": ["$call", "Then"], "to": ["$count", "Execute"]},
		{"op": "Connect", "from": ["$waits", "Value"], "to": ["$waitsNext", "waits"]},
		{"op": "Connect", "from": ["$waitsNext", "Result"], "to": ["$count", "Value"]},
		{"op": "Connect", "from": ["$count", "Then"], "to": ["$end", "Execute"]},
		{"op": "Arrange", "scope": "Graph"},
		{"op": "Arrange", "function": "Pause", "scope": "Graph"}
	] },
	{ "graph": "asset://Scripts/Pinger.sgraph", "description": "Ping itself and tick every Ponger on every update", "operations": [
		{"op": "AddVariable", "name": "Pings", "type": "int", "public": true},
		{"op": "AddVariable", "name": "Echoes", "type": "int"},
		{"op": "AddNode", "type": "Expression", "settings": {"Formula": "pings + 1"}, "as": "$pingsNext"},
		{"op": "AddNode", "type": "Variable.Get", "settings": {"Variable": "Pings"}, "as": "$pings"},
		{"op": "AddNode", "type": "Variable.Set", "settings": {"Variable": "Pings"}, "as": "$count"},
		{"op": "AddNode", "type": "Event.Send", "settings": {"Name": "Ping"}, "as": "$send"},
		{"op": "AddNode", "type": "Event.Broadcast", "settings": {"Name": "Tick", "Graph": "asset://Scripts/Ponger.sgraph"}, "as": "$broadcast"},
		{"op": "AddNode", "type": "Event.Custom", "settings": {"Name": "Ping"}, "as": "$ping"},
		{"op": "AddNode", "type": "Expression", "settings": {"Formula": "echoes + 1"}, "as": "$echoesNext"},
		{"op": "AddNode", "type": "Variable.Get", "settings": {"Variable": "Echoes"}, "as": "$echoes"},
		{"op": "AddNode", "type": "Variable.Set", "settings": {"Variable": "Echoes"}, "as": "$echo"},
		{"op": "Connect", "from": ["$pings", "Value"], "to": ["$pingsNext", "pings"]},
		{"op": "Connect", "from": ["$pingsNext", "Result"], "to": ["$count", "Value"]},
		{"op": "Connect", "from": [2, "Then"], "to": ["$count", "Execute"]},
		{"op": "Connect", "from": ["$count", "Then"], "to": ["$send", "Execute"]},
		{"op": "Connect", "from": ["$send", "Then"], "to": ["$broadcast", "Execute"]},
		{"op": "Connect", "from": ["$echoes", "Value"], "to": ["$echoesNext", "echoes"]},
		{"op": "Connect", "from": ["$echoesNext", "Result"], "to": ["$echo", "Value"]},
		{"op": "Connect", "from": ["$ping", "Then"], "to": ["$echo", "Execute"]},
		{"op": "Arrange", "scope": "Graph"}
	] }
]
