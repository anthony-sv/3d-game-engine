{
	"Strada": {
		"Version": 3,
		"Type": "VisualScript"
	},
	"VisualScript": {
		"Description": "Counts its entity's contacts: collisions and triggers that begin and end. At the first collision that begins, it checks that Collision Enter gives the strongest point of Strada.Collision.Points (pushing the entity up, with an impulse) and the surface ExpectedSurface names; at the first contact that ends, that every contact that ended had begun. Checks counts the checks that passed, and Done is set when both have. The feature test's falling box (on the ground, which has no material) and ball (on the Contact Pad, of Rubber) run it next to their C# CollisionProbe. Its custom event Ping adds its Amount to Pings: Features.sgraph sends it to the box, broadcasts it to both and reads and writes Pings from there.",
		"Variables": [
			{
				"ID": 1,
				"Name": "CollisionsEntered",
				"Type": "int",
				"Value": 0,
				"Public": true,
				"Tooltip": "Collisions that began"
			},
			{
				"ID": 2,
				"Name": "CollisionsExited",
