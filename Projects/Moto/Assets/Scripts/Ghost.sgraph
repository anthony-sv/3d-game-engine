{
	"Strada": {
		"Version": 3,
		"Type": "VisualScript"
	},
	"VisualScript": {
		"Description": "The ghost bike: it rides the racing line round the lap without end, from StartAt seconds after the start and finish line (Tools/RacingLine.py makes its keys), and the ridden bike's best lap once it has one, which it records and keeps at the race director's events.",
		"Variables": [
			{
				"ID": 1,
				"Name": "StartAt",
				"Type": "float",
				"Value": 0.0,
				"Public": true,
				"Tooltip": "Where on its lap the ghost sets out, in seconds after the start and finish line",
				"Range": [
					0.0,
					71.11253356933594
				]
			},
			{
				"ID": 2,
				"Name": "Laps",
				"Type": "int",
				"Value": 0,
				"Public": true,
				"Tooltip": "How many times the ghost has crossed the start and finish line (a read-out)"
			},
			{
				"ID": 3,
				"Name": "LapTime",
				"Type": "float",
				"Value": 0.0,
				"Public": true,
				"Tooltip": "How far into its lap the ghost is, in seconds after the start and finish line (a read-out)"
			},
			{
				"ID": 4,
				"Name": "EngineSpeed",
				"Type": "float",
				"Value": 0.0,
				"Public": true,
				"Tooltip": "The ghost's engine speed in revolutions a minute, for its engine's sound (a read-out)"
			},
			{
				"ID": 5,
				"Name": "Load",
				"Type": "float",
				"Value": 0.0,
				"Public": true,
				"Tooltip": "How far open the ghost's throttle is, from 0 to 1, for its engine's sound (a read-out)"
			},
			{
				"ID": 6,
				"Name": "Engine",
				"Type": "Strada.Entity"
			},
			{
				"ID": 7,
				"Name": "Bike",
				"Type": "Strada.Entity",
				"Public": true,
				"Tooltip": "The ridden bike, whose laps the ghost records from the race director's LapStarted and keeps at its LapFinished when it is the best"
			},
			{
				"ID": 8,
				"Name": "BestLapPositions",
				"Type": "Strada.Vector3[]",
				"Value": [],
				"Public": true,
				"Tooltip": "The best lap's positions in the world, a value per sample, ten a second (empty while there is none; a game that loads them sends BestLapLoaded)"
			},
			{
				"ID": 9,
				"Name": "BestLapRotations",
				"Type": "Strada.Quaternion[]",
				"Value": [],
				"Public": true,
				"Tooltip": "The best lap's rotations in the world, a value per sample, ten a second (empty while there is none; a game that loads them sends BestLapLoaded)"
			},
			{
				"ID": 10,
				"Name": "BestLapEngineSpeeds",
				"Type": "float[]",
				"Value": [],
				"Public": true,
				"Tooltip": "The best lap's engine speeds (revolutions a minute), a value per sample, ten a second (empty while there is none; a game that loads them sends BestLapLoaded)"
			},
			{
				"ID": 11,
				"Name": "BestLapLoads",
				"Type": "float[]",
				"Value": [],
				"Public": true,
				"Tooltip": "The best lap's loads (the applied throttle, 0 to 1), a value per sample, ten a second (empty while there is none; a game that loads them sends BestLapLoaded)"
			},
			{
				"ID": 12,
				"Name": "BestLapTime",
				"Type": "float",
				"Value": 0.0,
				"Public": true,
				"Tooltip": "The best lap's time in seconds, 0 while there is none (no Delta then); a game that loads the samples sets it with them",
				"Range": [
					0.0,
					409.70001220703125
				]
			},
			{
