		"Version": 3,
		"Type": "VisualScript"
	},
	"VisualScript": {
		"Description": "An engine's sound: its children's voices, one an engine layer on or off load, crossfaded by the engine's speed and load through curve assets, each pitched within its layer's band. Whoever runs the engine sets EngineSpeed and Load. Tools/EngineSound.py says how.",
		"Variables": [
			{
				"ID": 1,
				"Name": "EngineSpeed",
				"Type": "float",
				"Value": 0.0,
				"Public": true,
				"Tooltip": "The engine's speed in revolutions a minute: whoever runs the engine sets it every update",
				"Range": [
					0.0,
					20000.0
				]
			},
			{
				"ID": 2,
				"Name": "Load",
				"Type": "float",
				"Value": 0.0,
				"Public": true,
				"Tooltip": "How far open the throttle is, from 0 (off load) to 1 (full load): whoever runs the engine sets it every update",
				"Range": [
					0.0,
					1.0
				]
			},
			{
				"ID": 3,
				"Name": "Volume",
				"Type": "float",
				"Value": 1.0,
				"Public": true,
				"Tooltip": "The engine's loudness: every voice's volume is scaled by it",
				"Range": [
					0.0,
					4.0
				]
			},
			{
				"ID": 4,
				"Name": "DopplerLevel",
				"Type": "float",
				"Value": 1.0,
				"Public": true,
				"Tooltip": "The doppler every voice takes when the scene starts: 0 none, 1 physical",
				"Range": [
					0.0,
					5.0
				]
			},
			{
