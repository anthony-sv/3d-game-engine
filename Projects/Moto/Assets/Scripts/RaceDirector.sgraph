				"Tooltip": "Where the race is: Idle, Title, Countdown, Racing or Results (a read-out)"
			},
			{
				"ID": 8,
				"Name": "Lap",
				"Type": "int",
				"Value": 0,
				"Public": true,
				"Tooltip": "The lap being ridden, from 1; 0 before the first crossing of the line (a read-out)"
			},
			{
				"ID": 9,
				"Name": "LapTime",
				"Type": "float",
				"Value": 0.0,
				"Public": true,
				"Tooltip": "The lap's time so far, or the last lap's at the results (seconds, a read-out)"
			},
			{
				"ID": 10,
				"Name": "BestLapTime",
				"Type": "float",
				"Value": 0.0,
				"Public": true,
				"Tooltip": "The best lap's time, 0 when there is none (seconds, a read-out)"
			},
			{
				"ID": 11,
				"Name": "LastLapTime",
				"Type": "float",
				"Value": 0.0,
				"Public": true,
				"Tooltip": "The last lap finished (seconds, a read-out)"
			},
