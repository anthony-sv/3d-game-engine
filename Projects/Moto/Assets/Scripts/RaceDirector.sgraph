{
	"Strada": {
		"Version": 3,
		"Type": "VisualScript"
	},
	"VisualScript": {
		"Description": "The race director: the time trial's states from the title to the results, the laps and sectors timed from the gates' interpolated crossings in fixed steps, and the best lap kept in a save slot.",
		"Variables": [
			{
				"ID": 1,
				"Name": "Subject",
				"Type": "Strada.Entity",
				"Public": true,
				"Tooltip": "What the gates time: the ridden bike"
			},
			{
				"ID": 2,
				"Name": "Ghost",
				"Type": "Strada.Entity",
				"Public": true,
				"Tooltip": "The ghost whose best lap's samples are saved with the best lap and loaded back"
			},
			{
				"ID": 3,
				"Name": "AudioDirector",
				"Type": "Strada.Entity",
				"Public": true,
				"Tooltip": "The audio director, sent TogglePause so that the mix follows the game's pause"
			},
			{
				"ID": 4,
				"Name": "TitleOnStart",
				"Type": "bool",
				"Value": true,
				"Public": true,
				"Tooltip": "On: the race opens on its title over the attract mode. Off: it starts idle, as Moto did before it had a race, until it is sent StartRace"
			},
			{
				"ID": 5,
				"Name": "Laps",
				"Type": "int",
				"Value": 3,
				"Public": true,
				"Tooltip": "How many laps the time trial has",
				"Range": [
					1.0,
					9.0
				]
			},
			{
				"ID": 6,
				"Name": "Countdown",
				"Type": "float",
				"Value": 3.0,
				"Public": true,
				"Tooltip": "How long the countdown lasts (seconds)",
