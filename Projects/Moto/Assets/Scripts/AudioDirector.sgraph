{
	"Strada": {
		"Version": 3,
		"Type": "VisualScript"
	},
	"VisualScript": {
		"Description": "The audio director: a TogglePause event (the race director's pause, or any graph's) blends the mix to the Paused snapshot and back; it plays the ridden bike's engine, tyres, gravel, wind and shifts from the vehicle, and the crowd at the grandstands. Tools/Sound.py says how.",
		"Variables": [
			{
				"ID": 1,
				"Name": "Seconds",
				"Type": "float",
				"Value": 0.5,
				"Public": true,
				"Tooltip": "How long the mix takes to blend to the Paused snapshot, and back",
				"Range": [
					0.0,
					10.0
				]
			},
			{
				"ID": 2,
				"Name": "Paused",
				"Type": "bool",
				"Value": false,
				"Public": true,
				"Tooltip": "Whether the mix is muffled by the Paused snapshot (a read-out)"
			},
			{
				"ID": 3,
				"Name": "StartPaused",
				"Type": "bool",
				"Value": false,
				"Public": true,
				"Tooltip": "Whether the mix starts muffled, blending to the Paused snapshot when the scene starts (a game that opens paused)"
			},
			{
				"ID": 4,
				"Name": "RideSounds",
				"Type": "bool",
				"Value": true,
				"Public": true,
				"Tooltip": "Whether the director plays the ridden bike's sounds and the crowd; off, they stay silent, as Moto sounded before the bike was ridden (the test scene)"
			},
			{
				"ID": 5,
				"Name": "Bike",
				"Type": "Strada.Entity",
				"Public": true,
				"Tooltip": "The ridden bike, whose engine, tyres, gravel, wind and shifts the director plays"
			},
			{
				"ID": 6,
				"Name": "Blips",
				"Type": "int",
				"Value": 0,
				"Public": true,
