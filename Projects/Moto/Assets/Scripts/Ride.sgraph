						"Formula": "curve * 1.3 - (atan2(dot(vec2(f.X, f.Z), normalize(vec2(a.Z - c.Z, c.X - a.X))), dot(vec2(f.X, f.Z), normalize(vec2(c.X - a.X, c.Z - a.Z)))) + clamp(offset / (max(v, 5.0) * 1.2), -0.3, 0.3)) / (max(v, 5.0) * 0.4)"
					}
