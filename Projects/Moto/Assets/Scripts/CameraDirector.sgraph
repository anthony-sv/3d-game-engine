{
	"Strada": {
		"Version": 3,
		"Type": "VisualScript"
	},
	"VisualScript": {
		"Description": "The camera director: it cuts between the tour's camera and its children, the trackside cameras and the chase camera, on the NextCamera and ResetCamera actions (or the events of those names any graph sends), by its own rule in the attract mode and to the chase view in the race (the race director's AttractStarted and RaceStarted), and turns the trackside camera that shows to follow. Tools/Trackside.py says how.",
		"Variables": [
			{
				"ID": 1,
				"Name": "TourCamera",
				"Type": "Strada.Entity",
				"Public": true,
				"Tooltip": "The camera the tour flies: it shows and hears the scene when no other camera does"
			},
			{
				"ID": 2,
				"Name": "Subject",
				"Type": "Strada.Entity",
				"Public": true,
				"Tooltip": "What the trackside cameras follow in the attract mode (the ghost)"
			},
			{
				"ID": 3,
				"Name": "Bike",
				"Type": "Strada.Entity",
				"Public": true,
				"Tooltip": "The ridden bike: the chase camera follows it, and so do the trackside cameras in the race"
			},
			{
				"ID": 4,
				"Name": "StartCamera",
				"Type": "int",
				"Value": 0,
				"Public": true,
				"Tooltip": "The camera that shows when the scene starts: 0 the tour, 1 to 7 a trackside camera, 8 the chase camera (any other number is warned of, and the tour shows)",
				"Range": [
					0.0,
					8.0
				]
			},
			{
				"ID": 5,
				"Name": "Active",
				"Type": "int",
				"Value": 0,
				"Public": true,
				"Tooltip": "The camera that shows: 0 the tour, 1 to 7 a trackside camera, 8 the chase camera (a read-out)"
			},
			{
				"ID": 6,
				"Name": "Directs",
				"Type": "bool",
				"Value": true,
				"Public": true,
				"Tooltip": "Whether the director cuts by itself once the race director starts the attract mode or the race; off, it cuts only when told (StartCamera, NextCamera and ResetCamera)"
			},
			{
				"ID": 7,
				"Name": "Mode",
				"Type": "int",
				"Value": 0,
				"Public": true,
				"Tooltip": "How the director cuts: 0 when told, 1 the attract mode (by its rule), 2 the race (the chase view) (a read-out)"
			},
			{
				"ID": 8,
				"Name": "Hold",
				"Type": "float",
				"Value": 3.0,
				"Public": true,
				"Tooltip": "How long a camera shows at least in the attract mode before the rule cuts away (seconds)",
				"Range": [
					0.0,
					30.0
				]
			},
