			{
				"ID": 1,
				"Name": "Race",
				"Type": "Strada.Entity",
				"Public": true,
				"Tooltip": "The race director, whose state and pause choose the screen and whose events the buttons send"
			},
			{
				"ID": 2,
				"Name": "Rider",
				"Type": "Strada.Entity",
				"Public": true,
				"Tooltip": "The bike whose riding graph takes the linked brakes' settings"
			},
			{
