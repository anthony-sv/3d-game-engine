{
	"Strada": {
		"Version": 3,
		"Type": "VisualScript"
	},
	"VisualScript": {
		"Description": "The bike's riding graph: at each fixed step it gives the vehicle its driver's throttle, brakes and lean through the rider assists, and it shifts when its driver asks or the automatic shifts say; each frame it poses the rider and turns the fork. The only writer of the bike's inputs and shifts.",
		"Variables": [
			{
				"ID": 1,
				"Name": "Driver",
				"Type": "int",
				"Value": 0,
				"Public": true,
				"Tooltip": "Who rides the bike: 0 the player (the actions), 1 the autopilot, 2 a test (both write Throttle, FrontBrake, RearBrake and Lean, and send ShiftUp and ShiftDown)",
				"Range": [
					0.0,
					2.0
				]
			},
			{
				"ID": 2,
				"Name": "Throttle",
				"Type": "float",
				"Value": 0.0,
				"Public": true,
				"Tooltip": "The throttle the autopilot or a test asks for, 0 to 1 (read while Driver is not 0)",
				"Range": [
					0.0,
					1.0
				]
			},
			{
				"ID": 3,
				"Name": "FrontBrake",
				"Type": "float",
				"Value": 0.0,
				"Public": true,
				"Tooltip": "The front brake the autopilot or a test asks for, 0 to 1 (read while Driver is not 0)",
				"Range": [
					0.0,
					1.0
				]
			},
			{
				"ID": 4,
				"Name": "RearBrake",
				"Type": "float",
				"Value": 0.0,
				"Public": true,
				"Tooltip": "The rear brake the autopilot or a test asks for, 0 to 1 (read while Driver is not 0)",
				"Range": [
					0.0,
					1.0
				]
			},
			{
				"ID": 5,
				"Name": "Lean",
				"Type": "float",
				"Value": 0.0,
				"Public": true,
				"Tooltip": "The lean the autopilot or a test asks for, -1 left to 1 right (read while Driver is not 0)",
				"Range": [
					-1.0,
					1.0
				]
			},
			{
				"ID": 6,
				"Name": "LeanAssist",
				"Type": "bool",
				"Value": true,
				"Public": true,
				"Tooltip": "The rider assist: the lean asked for is a lean, a share of the lean limit, which the assist steers the bike into at its speed (off: it is the steering itself)"
			},
			{
				"ID": 7,
				"Name": "LinkedBrakes",
				"Type": "bool",
				"Value": true,
				"Public": true,
				"Tooltip": "The linked brakes: the front brake also applies the rear by LinkedBrakeShare, and both ease as the bike leans (off: each brake alone, as given)"
			},
			{
				"ID": 8,
				"Name": "LinkedBrakeShare",
				"Type": "float",
				"Value": 0.3,
				"Public": true,
				"Tooltip": "How much of the front brake the linked brakes give the rear, 0 to 1",
				"Range": [
					0.0,
					1.0
				]
			},
			{
				"ID": 9,
				"Name": "AutoShift",
				"Type": "bool",
				"Value": true,
				"Public": true,
				"Tooltip": "The automatic shifts: out of neutral when the throttle opens, up and down by the engine's speed at the definition's shift speeds (off: only the rider shifts)"
			},
			{
				"ID": 10,
				"Name": "Rider",
				"Type": "Strada.Entity",
				"Public": true,
				"Tooltip": "The rider, found among the bike's children at the start (a read-out)"
			},
			{
				"ID": 11,
				"Name": "Fork",
				"Type": "Strada.Entity",
				"Public": true,
				"Tooltip": "The fork, found among the bike's children at the start (a read-out)"
			},
			{
				"ID": 12,
				"Name": "FrontWheel",
				"Type": "Strada.Entity",
				"Public": true,
				"Tooltip": "The front wheel, the fork's child, found at the start (a read-out)"
			},
			{
				"ID": 13,
				"Name": "ShiftWait",
				"Type": "int",
				"Value": 0
			}
		],
