			{
				"ID": 1,
				"Name": "Driver",
				"Type": "int",
				"Value": 0,
				"Public": true,
				"Tooltip": "Who rides the bike: 0 the player (the actions), 1 the autopilot, 2 a test (both write Throttle, FrontBrake, RearBrake and Lean, and send ShiftUp and ShiftDown)",
				"Range": [
					0.0,
					2.0
				]
			},
